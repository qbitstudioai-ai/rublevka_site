# Секреты и локальные данные никогда не попадают в образ.
.env
.env.*
!.env.example
data/
backups/
.e2e-data/

# Зависимости и сборка — устанавливаются и собираются внутри образа.
node_modules/
.next/
out/

# Тесты, отчёты, документация и служебное.
.git/
test-results/
playwright-report/
docs/
tests/
# Конфиг Playwright импортирует tests/ — без него проверка типов при сборке падает.
playwright.config.ts
*.log
*.sqlite
*.sqlite-wal
*.sqlite-shm
.claude/
.vscode/
