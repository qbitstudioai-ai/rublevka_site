# Пример настроек. Локально скопируйте в .env.local, на сервере — в .env.production.
# Реальные значения не коммитить. Полный список и требования — DEPLOYMENT.md.

# ---------- Обязательные в production ----------

# Файл SQLite и каталог загруженных изображений. В Docker — пути на volume:
#   DATABASE_PATH=/data/db/rublevka.sqlite   UPLOADS_DIR=/data/uploads
# Не указывайте пути внутри .next/ или node_modules/ — запуск будет остановлен.
DATABASE_PATH=data/rublevka.sqlite
UPLOADS_DIR=data/uploads

# Публичный адрес сайта (https://…), используется в ссылках админпанели.
APP_URL=

# Единственный администратор. Пароль — не короче 12 символов.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Случайная строка не короче 32 символов:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# ---------- За reverse proxy ----------

# true — доверять X-Real-IP / X-Forwarded-For от вашего прокси (для ограничения частоты по IP).
# Включайте, только если приложение недоступно из интернета напрямую, минуя прокси.
TRUST_PROXY=false

# ---------- Telegram-уведомления (необязательно, но только парой) ----------
# Токен бота от @BotFather и chat_id чата администрации (см. TELEGRAM.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Резервные копии (npm run backup, см. BACKUP.md) ----------
# Каталог архивов. В Docker — /data/backups на отдельном volume.
BACKUP_DIR=backups
# Сколько дней хранить архивы этого приложения (по умолчанию 30).
BACKUP_RETENTION_DAYS=30

# ---------- Только при необходимости ----------
# false — отключить флаг Secure у cookie сессии (временная работа без HTTPS).
# ADMIN_COOKIE_SECURE=false
