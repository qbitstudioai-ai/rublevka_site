# Preview is noindex by default and must use its own origin.
SITE_URL=http://localhost:3000
SEO_INDEXING_ENABLED=false

# At production launch set the real HTTPS origin and explicitly enable indexing.
# SITE_URL=https://rublevka34.com
# SEO_INDEXING_ENABLED=true

# AI-01: chat is disabled until project review.
ASSISTANT_CHAT_ENABLED=false
ASSISTANT_KNOWLEDGE_KEY=
ASSISTANT_EVENTS_KEY=
ASSISTANT_N8N_WEBHOOK_URL=
ASSISTANT_N8N_WEBHOOK_KEY=
ASSISTANT_N8N_CALLBACK_KEY=
ASSISTANT_OPERATOR_KEY=
ASSISTANT_RETENTION_HOURS=24
# EVENTS_ORIGINAL_ORIGIN=http://127.0.0.1:3271
# EVENTS_ASSISTANT_MOUNTED=true  # Set only on the same-origin events process.
