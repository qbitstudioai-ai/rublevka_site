{
  "name": "rublevka-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test src/content/*.test.ts src/components/book/*.test.tsx src/components/events/*.test.ts src/components/site-admin/*.test.tsx src/components/territory-map/*.test.tsx",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:db && npm run build",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "events:import": "tsx scripts/import-events.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:db": "node scripts/test-events-db.mjs",
    "site:admin:create": "node --env-file-if-exists=.env --import tsx scripts/create-site-admin.ts",
    "site:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-site-cms.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "iron-session": "^9.1.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "9.39.3",
    "eslint-config-next": "16.4.6",
    "image-size": "^2.1.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
