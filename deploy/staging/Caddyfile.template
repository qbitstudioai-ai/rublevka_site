{$STAGING_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	encode zstd gzip
	request_body {
		max_size 32MB
	}

	@internal path /meropriyatiya/api/internal /meropriyatiya/api/internal/*
	route {
		respond @internal 404
		handle /robots.txt {
			respond <<ROBOTS
			User-agent: *
			Disallow: /
			ROBOTS
		}
		handle {
			reverse_proxy {$STAGING_UPSTREAM}
		}
	}
}
